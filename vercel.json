{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/en",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/models",
      "destination": "https://apilatencytest.onrender.com/api/models"
    },
    {
      "source": "/api/test",
      "destination": "https://apilatencytest.onrender.com/api/test"
    },
    {
      "source": "/v1/models",
      "destination": "https://apilatencytest.onrender.com/v1/models"
    },
    {
      "source": "/v1/chat/completions",
      "destination": "https://apilatencytest.onrender.com/v1/chat/completions"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/zh/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/en/pricing",
      "destination": "/pricing-en.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/zh/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/en/contact",
      "destination": "/contact-en.html"
    },
    {
      "source": "/openai-api-latency-test",
      "destination": "/openai-api-latency-test.html"
    },
    {
      "source": "/api-relay-test",
      "destination": "/api-relay-test.html"
    },
    {
      "source": "/ttft-test",
      "destination": "/ttft-test.html"
    }
  ],
  "functions": {
    "api/models.js": {
      "maxDuration": 30
    },
    "api/test.js": {
      "maxDuration": 60
    }
  }
}
